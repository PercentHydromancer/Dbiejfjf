# Copy these keys into Render -> Web Service -> Environment.
# IMPORTANT: don't commit passwords, database credentials or transfer details to GitHub.
# Keep actual values in Render Environment, NOT in this file.

# Persistent database from Render Postgres (Internal Database URL).
DATABASE_URL=

# Separate administrator credentials; password >= 12 characters.
ADMIN_LOGIN=Хади
ADMIN_PASSWORD=

# Manual transfers. Set RECEIVER and at least CARD or PHONE to enable purchase requests.
PAYMENT_RECEIVER=
PAYMENT_BANK=
PAYMENT_CARD=
PAYMENT_PHONE=

# Optional (keyless anonymous cloud inference is enabled by default).
KEYLESS_CLOUD_ENABLED=true
